#!/bin/bash
set -euo pipefail
# Refuse installing privileged files through a user-controlled symlink/path.
for ntfs_path in '/Library' '/Library/Application Support' '/Library/Application Support/NTFS Desktop' '/Library/Application Support/NTFS Desktop/Runtime'; do
  [ ! -L "$ntfs_path" ] || { echo 'Unsafe runtime path: symbolic link' >&2; exit 1; }
  if [ -e "$ntfs_path" ]; then
    [ "$(/usr/bin/stat -f %u "$ntfs_path")" = 0 ] || { echo 'Unsafe runtime path: not root-owned' >&2; exit 1; }
    ntfs_mode=$(/usr/bin/stat -f %Lp "$ntfs_path")
    (( (8#$ntfs_mode & 8#022) == 0 )) || { echo 'Unsafe runtime path: writable by other users' >&2; exit 1; }
  fi
done

# Stop accepting mounts before replacing executable files. Refuse an in-flight mount.
/usr/bin/touch /var/run/com.macntfs.updating
if /usr/sbin/lsof -t /var/run/com.macntfs.mount-active >/dev/null 2>&1; then
  /bin/rm -f /var/run/com.macntfs.updating
  echo 'macntfs is mounting a disk. Wait for completion and retry.' >&2
  exit 1
fi
# Also protect manual PKG installs: established mounts and VM/driver teardown.
if /sbin/mount | /usr/bin/grep -Eq ' on /Volumes/(NTFS|macntfs-VM)-disk[0-9]+s[0-9]+ \('; then
  /bin/rm -f /var/run/com.macntfs.updating
  echo 'Safely eject disks managed by macntfs before updating. Close open files and retry.' >&2
  exit 1
fi
for ntfs_binary in '/Library/Application Support/NTFS Desktop/Runtime/bin/ntfs-3g' '/Library/Application Support/NTFS Desktop/Runtime/MicroVM/bin/anylinuxfs'; do
  if [ -f "$ntfs_binary" ]; then
    ntfs_lsof=0
    /usr/sbin/lsof -t -- "$ntfs_binary" >/dev/null 2>&1 || ntfs_lsof=$?
    if [ "$ntfs_lsof" != 1 ]; then
      /bin/rm -f /var/run/com.macntfs.updating
      echo 'Disk service is active or cannot be inspected. Wait for safe unmount and retry.' >&2
      exit 1
    fi
  fi
done
/bin/launchctl bootout system/com.macntfs.helper >/dev/null 2>&1 || true
