{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "macntfs",
  "version": "0.3.15",
  "identifier": "com.yuntu.ntfs-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "macntfs",
        "width": 1060,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600,
        "titleBarStyle": "Transparent"
      },
      {
        "label": "tray-panel",
        "title": "macntfs 磁盘快捷操作",
        "url": "index.html?panel",
        "width": 420,
        "height": 540,
        "visible": false,
        "focus": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0MjI4OUVBREYyRTc3QTEKUldTaGR5N2Y2b2tpZEM5MnJ6S2l5K0hqNU1oM3dCa3lUMVVhdkZybGVtVG00UHAyVzAvVGNrWloK",
      "endpoints": [
        "https://github.com/luckySpro/macntfs/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
